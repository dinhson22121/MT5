; EA v4.0 Phase 1 - AGGRESSIVE Profile
; Target: 52-57% Win Rate | 12-18 Trades/Week
; Risk: MODERATE-HIGH | Use after Phase 1 proven
; Recommended for: Experienced users with proven strategy
;
; FEATURES:
; - Moderately relaxed filters
; - More trading opportunities
; - Higher trade frequency
; - Slightly lower win rate but more action
;
; WARNING: Only use AFTER testing Conservative profile successfully!
;
; HOW TO USE:
; 1. Right-click EA on chart → Properties
; 2. Go to "Inputs" tab
; 3. Click "Load" button
; 4. Select this file (Aggressive_Phase1.set)
; 5. Click OK
;
InpEnableScalping=true
;
; === PHASE 1 CORE FILTERS (MODERATELY RELAXED) ===
InpMinADX=23.0
InpVolumeMultiplier=1.4
InpMinATRMultiplier=0.75
;
; === PATTERN DETECTION (MANDATORY - MODERATE) ===
InpRequireCandlePattern=true
InpMinEngulfingRatio=1.4
InpMinPinbarWickRatio=2.3
;
; === INDICATOR SETTINGS ===
InpRSIPeriod_Scalp=7
InpRSIPeriod_LongTerm=14
InpRSIOversold=30
InpRSIOverbought=70
InpUseRSIConfirmation=true
InpEMAFast=34
InpEMASlow=89
InpADXPeriod=14
;
; === VOLUME FILTER ===
InpVolumePeriod=20
;
; === RISK MANAGEMENT - SCALPING (Moderate-Aggressive) ===
InpPositionSizePercent=1.5
InpMaxLotSize=1.00
InpStopLossPips_Scalp=40
InpTakeProfitPips_Scalp=70
InpBreakevenPips_Scalp=40
InpTrailingActivatePips_Scalp=40
InpTrailingDistancePips_Scalp=20
;
; === RISK MANAGEMENT - LONG-TERM ===
InpStopLossPips_LongTerm=80
InpTakeProfitPips_LongTerm=200
InpBreakevenPips_LongTerm=100
InpTrailingActivatePips_LongTerm=80
InpTrailingDistancePips_LongTerm=50
;
InpUseTrailingStop=true
InpUseAutoMaxPositions=true
InpMaxPositions=4
InpMagicNumber=123456
;
; === TRADING MODES (Both trend and sideway) ===
InpAllowTrendingBuy=true
InpAllowTrendingSell=true
InpAllowSidewayTrade=true
;
; === SIDEWAYS TRADING SETTINGS ===
InpSidewayStopLossPips_Scalp=40
InpSidewayTakeProfitPips_Scalp=70
InpSidewayStopLossPips_LongTerm=80
InpSidewayTakeProfitPips_LongTerm=200
InpSidewayRangePeriod=50
InpSidewayMinRangePips=180
InpSidewayMaxDistanceToBoundary=35
;
; === MOMENTUM TRADING (PHASE 1: DISABLED) ===
InpAllowMomentumTrade=false
InpUseMomentumConfirmation=false
InpMomentumStopLossPips_Scalp=40
InpMomentumTakeProfitPips_Scalp=70
InpMomentumStopLossPips_LongTerm=80
InpMomentumTakeProfitPips_LongTerm=200
InpMomentumVolumeMultiplier=1.5
InpMomentumATRMultiplier=1.2
;
; === TRADING RULES (Shorter cooldown) ===
InpMinutesBetwenTrades=20
InpCooldownSeconds=1200
InpAllowOnCurrentBar=false
InpUseTimeFilter=true
InpTradeAsianSession=false
InpTradeEuropeanSession=true
InpTradeUSSession=true
;
; === ADDITIONAL FILTERS (Moderate) ===
InpATRPeriod=14
InpMaxSpreadPips=6
InpUseCandleConfirmation=true
;
; === DEBUG SETTINGS ===
InpEnableDetailedLogs=true
InpEnableFileLogging=true
InpDebugLogFileName=EA_Aggressive_DebugLog.csv
