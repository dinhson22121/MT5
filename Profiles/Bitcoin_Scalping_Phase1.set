; EA v4.0 Phase 1 - BITCOIN SCALPING Profile
; Target: 55-60% Win Rate | 12-18 Trades/Week
; Risk: MODERATE | Timeframe: M15
; Best for: BTCUSD (Bitcoin) 24/7 trading
;
; HOW TO USE:
; 1. Right-click EA on chart → Properties
; 2. Go to "Inputs" tab
; 3. Click "Load" button
; 4. Select this file (Bitcoin_Scalping_Phase1.set)
; 5. Click OK
;
InpEnableScalping=true
;
; === PHASE 1 CORE FILTERS (STRENGTHENED FOR CRYPTO) ===
InpMinADX=25.0
InpVolumeMultiplier=1.5
InpMinATRMultiplier=0.8
;
; === PATTERN DETECTION (MANDATORY) ===
InpRequireCandlePattern=true
InpMinEngulfingRatio=1.5
InpMinPinbarWickRatio=2.5
;
; === INDICATOR SETTINGS ===
InpRSIPeriod_Scalp=7
InpRSIPeriod_LongTerm=14
InpRSIOversold=30
InpRSIOverbought=70
InpUseRSIConfirmation=true
InpEMAFast=34
InpEMASlow=89
InpADXPeriod=14
;
; === VOLUME FILTER ===
InpVolumePeriod=20
;
; === RISK MANAGEMENT - SCALPING (Lower risk for crypto) ===
InpPositionSizePercent=1.0
InpMaxLotSize=0.10
InpStopLossPips_Scalp=40
InpTakeProfitPips_Scalp=70
InpBreakevenPips_Scalp=40
InpTrailingActivatePips_Scalp=40
InpTrailingDistancePips_Scalp=20
;
; === RISK MANAGEMENT - LONG-TERM ===
InpStopLossPips_LongTerm=80
InpTakeProfitPips_LongTerm=200
InpBreakevenPips_LongTerm=100
InpTrailingActivatePips_LongTerm=80
InpTrailingDistancePips_LongTerm=50
;
InpUseTrailingStop=true
InpUseAutoMaxPositions=true
InpMaxPositions=3
InpMagicNumber=123456
;
; === TRADING MODES ===
InpAllowTrendingBuy=true
InpAllowTrendingSell=true
InpAllowSidewayTrade=false
;
; === SIDEWAYS TRADING SETTINGS ===
InpSidewayStopLossPips_Scalp=40
InpSidewayTakeProfitPips_Scalp=70
InpSidewayStopLossPips_LongTerm=80
InpSidewayTakeProfitPips_LongTerm=200
InpSidewayRangePeriod=50
InpSidewayMinRangePips=200
InpSidewayMaxDistanceToBoundary=30
;
; === MOMENTUM TRADING (PHASE 1: DISABLED) ===
InpAllowMomentumTrade=false
InpUseMomentumConfirmation=false
InpMomentumStopLossPips_Scalp=40
InpMomentumTakeProfitPips_Scalp=70
InpMomentumStopLossPips_LongTerm=80
InpMomentumTakeProfitPips_LongTerm=200
InpMomentumVolumeMultiplier=1.5
InpMomentumATRMultiplier=1.2
;
; === TRADING RULES (24/7 - No time filter) ===
InpMinutesBetwenTrades=45
InpCooldownSeconds=2700
InpAllowOnCurrentBar=false
InpUseTimeFilter=false
InpTradeAsianSession=true
InpTradeEuropeanSession=true
InpTradeUSSession=true
;
; === ADDITIONAL FILTERS (Wider spread for crypto) ===
InpATRPeriod=14
InpMaxSpreadPips=10
InpUseCandleConfirmation=true
;
; === DEBUG SETTINGS ===
InpEnableDetailedLogs=true
InpEnableFileLogging=true
InpDebugLogFileName=EA_DebugLog.csv
